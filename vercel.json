{
    "version": 2,
    "builds": [
        {
            "src": "src/graph-handler.ts",
            "use": "@vercel/node"
        },
        {
            "src": "src/main.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "^/graph/?$",
            "dest": "src/graph-handler.ts"
        },
        {
            "src": "^/(.*)$",
            "dest": "src/main.ts"
        }
    ]
}
